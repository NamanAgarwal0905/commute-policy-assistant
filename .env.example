
# Copy to .env. Defaults support the offline demo.

# Authentication
JWT_SECRET=

# LLM provider: extractive | groq | gemini
LLM_PROVIDER=extractive
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=3.0

# Embeddings: minilm | hash
EMBEDDING_PROVIDER=minilm

# Chunking: section | fixed
CHUNK_MODE=section
